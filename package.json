{
  "name": "@web4w3/mnemosyne",
  "version": "0.1.12",
  "description": "Source-to-source TS transpiler that traces dataflow into a value-provenance DAG, served over MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrey-karasev-gmail/mnemosyne.git"
  },
  "homepage": "https://web4w3.com/projects/mnemosyne",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./esbuild": {
      "types": "./dist/src/esbuild-plugin.d.ts",
      "default": "./dist/src/esbuild-plugin.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "trace": "ts-node --transpile-only src/run-example.ts",
    "trace:multifile": "ts-node --transpile-only src/run-example.ts examples/multi-file/main.ts",
    "mcp": "ts-node --transpile-only src/mcp-server.ts",
    "test": "node --test tests/*.test.js",
    "build": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "esbuild": ">=0.17.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^24.13.3",
    "date-fns": "^2.30.0",
    "esbuild": "^0.28.2",
    "lodash": "^4.17.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
